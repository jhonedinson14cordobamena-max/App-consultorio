# Cual broker usar: "alpaca" (acciones/ETFs) o "binance" (cripto).
# Solo uno a la vez esta activo en cada corrida del agente.
BROKER=alpaca

# --- Alpaca (cuenta de PAPER TRADING, no la de dinero real) ---
# Se obtienen en https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=tu_api_key_de_paper
ALPACA_SECRET_KEY=tu_secret_key_de_paper

# true = paper trading (dinero simulado, datos de mercado reales).
# NUNCA cambiar a false sin haber revisado a fondo el codigo de gestion
# de riesgo y haber probado la estrategia durante semanas/meses en papel.
ALPACA_PAPER=true

# --- Binance (Spot TESTNET, no la cuenta real) ---
# Se generan claves de testnet iniciando sesion con GitHub en
# https://testnet.binance.vision (boton "Generate HMAC_SHA256 Key")
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# true = testnet (dinero simulado). NUNCA cambiar a false sin la misma
# revision deliberada que aplica a ALPACA_PAPER.
BINANCE_TESTNET=true

# Simbolos a operar, separados por coma.
# Con BROKER=alpaca usa tickers de acciones/ETFs: AAPL,MSFT,SPY
# Con BROKER=binance usa pares contra USDT: BTCUSDT,ETHUSDT
SYMBOLS=AAPL,MSFT,SPY

# Parametros de la estrategia (medias moviles simples)
FAST_SMA_PERIOD=20
SLOW_SMA_PERIOD=50

# Gestion de riesgo
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
# Freno "total" (kill switch permanente hasta reactivacion manual). Debe ser
# mayor que MAX_DAILY_LOSS_PCT: el freno diario debe saltar primero.
MAX_TOTAL_LOSS_PCT=10.0
STOP_LOSS_PCT=2.0

# Cada cuantos minutos evalua el mercado el agente
POLL_INTERVAL_MINUTES=15

# Tope de capital que el agente puede usar para calcular tamano de posicion,
# INDEPENDIENTE del equity total de la cuenta. Vacio = usa todo el equity.
MAX_CAPITAL_USD=

# Notificaciones por email (opcional). Si se deja vacio, las notificaciones
# solo se registran en el log, no se envian.
NOTIFY_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
