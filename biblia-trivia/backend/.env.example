# Copia este archivo a ".env" (que NUNCA se sube a git) y llena tus propios valores.
# No pegues tus llaves reales en el chat, en commits, ni en ningún archivo rastreado por git.

PORT=3001

# Origen(es) permitido(s) para CORS: el dominio donde sirves el frontend (index.html).
FRONTEND_ORIGIN=http://localhost:8080

# Secreto para firmar los tokens de sesión (JWT). Genera uno largo y aleatorio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# --- Credenciales de Wompi (Comercios > Configuración > Secretos de integración) ---
# Llave pública: se puede exponer en el frontend, empieza con pub_prod_ o pub_test_.
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de integridad: SOLO en el backend, nunca en el frontend. Usado para firmar el checkout.
WOMPI_INTEGRITY_SECRET=prod_integrity_xxxxxxxxxxxxxxxxxxxx

# Secreto de eventos: SOLO en el backend. Usado para verificar la firma de los webhooks de Wompi.
WOMPI_EVENTS_SECRET=prod_events_xxxxxxxxxxxxxxxxxxxx

# Ambiente de Wompi: "sandbox" usa el checkout de pruebas, "production" el real.
WOMPI_ENV=sandbox

# URL pública a la que Wompi redirige al usuario tras pagar (una página de tu frontend).
CHECKOUT_REDIRECT_URL=http://localhost:8080/index.html

# Precios en pesos colombianos (COP), en pesos normales (el backend los convierte a centavos).
PRICE_TIER_100_COP=38000
PRICE_TIER_120_COP=15000
